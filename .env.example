# ─────────────────────────────────────────────────────────
# Nextour 환경 변수 템플릿
# 사용법: cp .env.example .env.local 후 값 채우기
# 스키마 기준: src/shared/lib/env.ts (zod 파싱, 부팅 시 검증)
# ─────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────

# PostgreSQL 연결 URL
DATABASE_URL="postgresql://user:password@localhost:5432/nextour?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/nextour?schema=public"

# NextAuth.js v5 세션 암호화 키 (32바이트 이상)
# 생성:  openssl rand -base64 32
AUTH_SECRET=""

# ── Optional: 앱 URL (기본값 http://localhost:3000) ──────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Optional: Resend 이메일 매직링크 ──────────────────────
# 비워두면 로컬 개발에서 매직링크가 서버 콘솔에 출력됨 (DEV 폴백)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Nextour <noreply@nextour.example>"

# ── Optional: Kakao 소셜 로그인 ───────────────────────────
# 둘 다 설정해야 /login에 카카오 버튼 노출됨
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""

# ── Optional: Anthropic (AI 검색 / Claude Haiku 4.5) ─────
ANTHROPIC_API_KEY=""

# ── Optional: 하이브리드 검색 실 임베딩 (M-AI-SEARCH) ─────
# OPENAI_API_KEY: text-embedding-3-small(1536-dim) 호출 키.
OPENAI_API_KEY=""
# USE_REAL_EMBEDDING: 비-프로덕션에서도 실 임베딩 API를 켜는 스위치.
#   "0"/미설정 → dev는 DeterministicDevProvider(가짜 벡터, 외부 비용 0)
#   "1"        → NODE_ENV 무관하게 OpenAIEmbeddingProvider 사용
#                (OPENAI_API_KEY 필요 — 미설정 시 embed 호출이 명시적 실패)
USE_REAL_EMBEDDING="0"

# ── Optional: Upstash Redis 분산 캐시 (M-CACHE) ───────────
# 서버리스 인스턴스 고립(메모리 휘발) 방지용 분산 캐시.
# 둘 다 비우면 캐시 레이어가 no-op으로 강등 → 매 요청 원본
# 파이프라인 실행(dev 무중단, 외부 의존 0). 설정 시 1h TTL 캐시.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Optional: 토스페이먼츠 (Phase 2 M-PAYMENT) ────────────
# 🛑 NO-REAL-MONEY (CLAUDE.md §5): live_ 키 금지. test_ 샌드박스 키만 허용.
#    live_ 키를 넣으면 env 검증이 부팅을 막는다.
TOSS_CLIENT_KEY=""
TOSS_SECRET_KEY=""
TOSS_WEBHOOK_SECRET=""
# TOSS_API_BASE_URL: 미설정 시 실제 토스(https://api.tosspayments.com).
#   0단계(Mock)  → "http://localhost:4242" (+ mock-toss-server 실행)
#   1단계(샌드박스 실거래 테스트) → 이 줄을 비워/주석 처리해 실제 토스로
TOSS_API_BASE_URL=""
# PAYMENT_FORCE_REAL: 1단계 opt-in 스위치.
#   "0"/미설정 → 비-프로덕션은 dev Mock 폴백(결제창 없이 성공 시뮬레이션)
#   "1"        → 실제 토스 결제창 표시 (test_ 키라 과금 0, 샌드박스 실거래)
PAYMENT_FORCE_REAL="0"

# ── Optional: Supabase (스토리지·인증 — 향후) ─────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
