# ─────────────────────────────────────────────────────────
# Nextour 환경 변수 템플릿
# 사용법: cp .env.example .env.local 후 값 채우기
# 스키마 기준: src/shared/lib/env.ts (zod 파싱, 부팅 시 검증)
# ─────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────

# PostgreSQL 연결 URL
DATABASE_URL="postgresql://user:password@localhost:5432/nextour?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/nextour?schema=public"

# NextAuth.js v5 세션 암호화 키 (32바이트 이상)
# 생성:  openssl rand -base64 32
AUTH_SECRET=""

# ── Optional: 앱 URL (기본값 http://localhost:3000) ──────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Optional: Resend 이메일 매직링크 ──────────────────────
# 비워두면 로컬 개발에서 매직링크가 서버 콘솔에 출력됨 (DEV 폴백)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Nextour <noreply@nextour.example>"

# ── Optional: Kakao 소셜 로그인 ───────────────────────────
# 둘 다 설정해야 /login에 카카오 버튼 노출됨
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""

# ── Optional: Anthropic (AI 검색 / Claude Haiku 4.5) ─────
ANTHROPIC_API_KEY=""

# ── Optional: 토스페이먼츠 (Phase 2 M-PAYMENT) ────────────
TOSS_CLIENT_KEY=""
TOSS_SECRET_KEY=""
TOSS_WEBHOOK_SECRET=""

# ── Optional: Supabase (스토리지·인증 — 향후) ─────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
