# ╔══════════════════════════════════════════════════════════════════════╗
# ║  PostgreSQL                                                            ║
# ║  🛑 로컬 개발은 반드시 Docker 로컬 DB 를 사용한다 (운영 직결 금지).    ║
# ║     docker compose up -d  →  아래 로컬 값 사용. README "로컬 개발 DB    ║
# ║     셋업" 참고. 운영(Supabase) 자격증명은 Vercel 환경변수가 SSOT 이며   ║
# ║     로컬 .env 에 넣지 않는다 (실데이터 파괴 위험).                      ║
# ╚══════════════════════════════════════════════════════════════════════╝
# 로컬 개발(권장 기본값):
DATABASE_URL="postgresql://nextour:nextour_local_dev@localhost:5432/nextour"
DIRECT_URL="postgresql://nextour:nextour_local_dev@localhost:5432/nextour"
# 운영 형식(참고용 — 로컬에서 사용 금지): pooler 6543 + ?pgbouncer=true / direct 5432

# Auth.js
AUTH_SECRET="<32자 이상의 랜덤 비밀키>"
# AUTH_URL: 프로덕션 OAuth redirect_uri 의 origin 고정용 (예: https://nextour.app).
# 로컬은 비워두면 됨(trustHost 가 localhost 자동 신뢰). NextAuth v5 가 자동 인식하므로
# Vercel 환경변수로만 지정해도 동작 — 프로덕션 도메인 mismatch 방지에 권장.
# AUTH_URL="https://your-domain.example"
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""

# 구글 OAuth (ID는 반드시 .apps.googleusercontent.com 으로 끝나야 통과됨)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend (아웃박스 메일 — 예약 확정 / 환불 완료)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Gmail SMTP (매직링크 로그인 메일 transport)
# 도메인 인증 없이 임의 수신자에게 발송하기 위해 Gmail SMTP 사용.
# GMAIL_APP_PASSWORD: Google 계정 → 보안 → 2단계 인증 활성화 후
#   "앱 비밀번호"에서 발급한 16자리 코드(공백 제거). 일반 로그인 비밀번호 아님.
# 발신 표시명은 코드에서 "Nextour <GMAIL_USER>"로 자동 브랜딩.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Anthropic Claude
ANTHROPIC_API_KEY=""

# Toss Payments — test_ 샌드박스 키 (NO-REAL-MONEY: live_ 키 금지)
TOSS_CLIENT_KEY="test_ck_..."
TOSS_SECRET_KEY="test_sk_..."
TOSS_WEBHOOK_SECRET=""
# ── 단계 토글 ────────────────────────────────────────────
# [현재] 0단계 Mock: TOSS_API_BASE_URL=localhost + PAYMENT_FORCE_REAL=0 유지
# [1단계 샌드박스 실거래 테스트로 전환하려면]
#   1) TOSS_API_BASE_URL 줄을 주석 처리 → 실제 토스로 confirm
#   2) PAYMENT_FORCE_REAL="1" 로 변경 → 실제 토스 결제창 표시
TOSS_API_BASE_URL="http://localhost:4242"
PAYMENT_FORCE_REAL="0"

# Supabase Storage
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# M-OBS: 관측성 설정
OBSERVABILITY_LOG_LEVEL="debug"
SENTRY_DSN=""
APP_VERSION="local"

# Cron worker 인증용 비밀키 — production에서 required.
# /api/cron/* 라우트가 Authorization: Bearer 헤더로 이 값을 검증한다.
# 생성: `openssl rand -hex 32` (32자 이상 필수)
CRON_SECRET=""

# M-AI-SEARCH: 하이브리드 검색 키
OPENAI_API_KEY=""
# M-AI-SEARCH: 실 임베딩 provider 키 사용 여부 (1=real, 0=deterministic dev)
USE_REAL_EMBEDDING="0"

# M-CACHE: Upstash Redis 키
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# CSP 모드 — 'report-only' (기본, 위반 신고만) 또는 'enforce' (실제 차단).
# 신규 배포는 report-only 로 시작 → §5 Plan Task 6~8 정량 임계값 통과 후 enforce 전환.
CSP_MODE=report-only

# Phase 3 B2-C: Rate limit (속도 제한)
# 'enforce' (default) — 한도 초과 시 429 응답
# 'shadow'            — 한도 초과를 로그만 남기고 차단하지 않음 (점진 롤아웃)
# 미설정 = enforce
RATE_LIMIT_MODE=enforce

# Phase 12: 여권번호(PII) 암호화 키 (ADR-0041)
# AES-256-GCM 용 base64 인코딩 32바이트 키. production 필수, dev/test 권장.
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 키를 분실/교체하면 기존 암호문(enc:v1:) 복호화 불가 — 안전하게 보관할 것.
ENCRYPTION_KEY=
