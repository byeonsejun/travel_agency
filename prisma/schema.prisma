// Nextour Prisma schema
// PRD v0.2 / ARCHITECTURE.md 기반
// PostgreSQL + pgvector + Auth.js

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

// ─────────────────────────────────────────────────────────────
// 1. 사용자 & 인증 (Auth.js v5 표준)
// ─────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  phone         String?
  image         String?
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  passportProfile PassportProfile?
  bookings        Booking[]
  wishlists       Wishlist[]
  reviews         Review[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String // "kakao", "email", ...
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// 여권정보는 민감하므로 별도 테이블 + 추후 컬럼 단위 암호화 적용 가능
model PassportProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  lastNameEn  String
  firstNameEn String
  gender      Gender
  birthDate   DateTime @db.Date
  passportNo  String
  expireDate  DateTime @db.Date
  nationality String   @default("KR")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Gender {
  MALE
  FEMALE
}

// ─────────────────────────────────────────────────────────────
// 2. 상품 (Product)
// ─────────────────────────────────────────────────────────────

enum ProductStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model Product {
  id              String        @id @default(cuid())
  title           String
  summary         String        @db.Text
  aiSummary       String?       @db.Text // PDP 상단 AI 3줄 요약, 저장 시 사전 생성
  destination     String // "오사카, 일본"
  destinationCode String? // 검색 필터용 ISO 등 (예: "JP-OSA")
  durationNights  Int
  durationDays    Int
  heroImageUrl    String?
  status          ProductStatus @default(DRAFT)
  basePriceAdult  Int // 노출용 시작가 (실가격은 Departure)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tags          ProductTag[]
  inclusions    Inclusion[]
  itineraryDays ItineraryDay[]
  departures    Departure[]
  embedding     ProductEmbedding?
  wishlists     Wishlist[]
  reviews       Review[]
  embeddingJobs EmbeddingJob[]

  @@index([status, destinationCode])
}

// 사용자가 관심 상품을 저장하는 즐겨찾기 (PRD §4.2)
// 가격/좌석 변동 알림은 의도적으로 미포함 — 체리피킹 유도 방지 (사용자 정책 결정).
model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt(sort: Desc)])
}

model ProductTag {
  id        String @id @default(cuid())
  productId String
  tag       String // "#노쇼핑", "#출발확정", "#가족", ...

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, tag])
  @@index([tag])
}

enum InclusionKind {
  INCLUDED
  EXCLUDED
}

model Inclusion {
  id        String        @id @default(cuid())
  productId String
  kind      InclusionKind
  label     String
  note      String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, kind])
}

model ItineraryDay {
  id            String  @id @default(cuid())
  productId     String
  dayNumber     Int
  title         String
  accommodation String?
  meals         Json // { breakfast: "호텔", lunch: "현지식", dinner: "X" }

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stops   ItineraryStop[]

  @@unique([productId, dayNumber])
}

model ItineraryStop {
  id             String  @id @default(cuid())
  itineraryDayId String
  order          Int
  time           String? // "10:00" / "오전"
  place          String
  description    String? @db.Text

  day ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)

  @@index([itineraryDayId, order])
}

// pgvector 임베딩
// 주의: Prisma는 vector 타입을 네이티브 지원하지 않으므로 Unsupported로 표기.
// 마이그레이션 후 별도 SQL로 ivfflat 인덱스 추가:
//   CREATE INDEX product_embedding_vector_idx ON "ProductEmbedding"
//     USING ivfflat (vector vector_cosine_ops) WITH (lists = 100);
model ProductEmbedding {
  productId    String                      @id
  vector       Unsupported("vector(1536)")
  modelVersion String // "claude-embed-v1" 등 — 모델 교체 시 일괄 재색인 키
  contentHash  String? // 마지막으로 임베딩된 콘텐츠 해시 (재인덱싱 판단용, 기존 row 호환을 위해 nullable)
  updatedAt    DateTime                    @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// 3. 출발 / 재고 (Departure)
// ─────────────────────────────────────────────────────────────

enum DepartureStatus {
  SCHEDULED // 모객 중
  CONFIRMED // 최소 인원 달성 → 출발 확정
  CLOSED // 마감
  CANCELED // 모객 실패 등으로 출발 취소
}

model Departure {
  id            String          @id @default(cuid())
  productId     String
  departureDate DateTime        @db.Date
  returnDate    DateTime        @db.Date
  priceAdult    Int
  priceChild    Int
  priceInfant   Int             @default(0)
  capacity      Int // 총 가능 좌석
  bookedSeats   Int             @default(0) // 비관적 락으로 변경
  minPax        Int // 최소 출발 인원
  status        DepartureStatus @default(SCHEDULED)
  version       Int             @default(0) // 낙관적 락 보조용
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  product       Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  cancellations DepartureCancellation[]

  @@unique([productId, departureDate])
  @@index([departureDate, status])
}

// ─────────────────────────────────────────────────────────────
// 4. 예약 & 결제
// ─────────────────────────────────────────────────────────────

enum BookingStatus {
  RECEIVED // 예약 접수, 무결제 대기
  AWAITING_GROUP // 최소 인원 미달, 모객 대기
  DEPARTURE_CONFIRMED // 출발 확정 → 결제 요청
  PAID // 결제 완료
  READY // E-ticket 발급 완료
  COMPLETED // 여행 완료
  CANCELED_BY_USER
  CANCELED_BY_AGENCY
}

model Booking {
  id           String        @id @default(cuid())
  userId       String
  departureId  String
  adultCount   Int           @default(0)
  childCount   Int           @default(0)
  infantCount  Int           @default(0)
  totalPrice   Int // 결제 시점에 서버에서 재계산해 검증
  status       BookingStatus @default(RECEIVED)
  notes        String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  canceledAt   DateTime?
  cancelReason String?
  paymentDueAt DateTime? // DEPARTURE_CONFIRMED 진입 시 set (결제 만료 cron용)

  user          User           @relation(fields: [userId], references: [id])
  departure     Departure      @relation(fields: [departureId], references: [id])
  travelers     Traveler[]
  terms         BookingTerms[]
  payments      Payment[]
  events        BookingEvent[]
  paymentEvents PaymentEvent[]
  refundJobs    RefundJob[]
  emailJobs     EmailJob[]
  review        Review?

  @@index([userId, status])
  @@index([departureId, status])
  @@index([status, paymentDueAt])
}

enum TravelerRole {
  BOOKER // 예약자 (결제자) — 본인이 함께 가지 않을 수도 있음
  TRAVELER // 실제 탑승자
}

enum PaxType {
  ADULT
  CHILD
  INFANT
}

enum RefundKind {
  FULL_CANCEL
  TRAVELER_CANCEL
  DISCRETIONARY
}

model Traveler {
  id          String       @id @default(cuid())
  bookingId   String
  role        TravelerRole
  lastNameEn  String
  firstNameEn String
  gender      Gender
  birthDate   DateTime     @db.Date
  passportNo  String?
  expireDate  DateTime?    @db.Date
  phone       String?
  email       String?

  // Phase 8: 여행자 단위 부분 환불 Ledger 필드
  paxType               PaxType?
  unitPrice             Int       @default(0)
  canceledAt            DateTime?
  canceledByRefundJobId String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model BookingTerms {
  id          String   @id @default(cuid())
  bookingId   String
  termKey     String // "standard_overseas_v1", "special_v3"
  termVersion String
  agreedAt    DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, termKey])
}

// 상태 전이 감사 로그
model BookingEvent {
  id        String         @id @default(cuid())
  bookingId String
  fromState BookingStatus?
  toState   BookingStatus
  actor     String // "user:{id}" | "admin:{id}" | "system:cron"
  reason    String?
  createdAt DateTime       @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

enum PaymentMethod {
  CARD
  VIRTUAL_ACCOUNT
  TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELED
  PARTIAL_CANCELED
  FAILED
}

model Payment {
  id             String        @id @default(cuid())
  bookingId      String
  method         PaymentMethod
  amount         Int
  status         PaymentStatus @default(PENDING)
  tossOrderId    String        @unique // 멱등성 키
  tossPaymentKey String?       @unique // 토스 확정 후 발급
  receiptUrl     String?
  failureCode    String?
  failureMessage String?
  paidAt         DateTime?
  canceledAt     DateTime?
  // Phase 8: 여러 부분 환불 누적 총액. 불변식: 0 ≤ refundedAmount ≤ amount
  refundedAmount Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  booking       Booking        @relation(fields: [bookingId], references: [id])
  paymentEvents PaymentEvent[]
  refundJobs    RefundJob[]

  @@index([bookingId, status])
}

// ─────────────────────────────────────────────────────────────
// 5. 결제 이벤트 & 환불 (M-PAYMENT)
// ─────────────────────────────────────────────────────────────

enum PaymentEventResult {
  PROCESSED // 정상 반영
  SKIPPED // 중복(idempotent no-op)
  IGNORED // 알 수 없는 type, 의도적 무시
  FAILED // 처리 중 예외 — 재시도 후보
}

model PaymentEvent {
  id              String             @id @default(cuid())
  providerEventId String             @unique // 멱등 키 (Toss eventId 또는 confirm:${paymentKey} 등)
  bookingId       String?
  paymentId       String?
  type            String // "CONFIRM_REQUEST" | "WEBHOOK:PAYMENT_DONE" | "REFUND_REQUEST" | ...
  payload         Json // 원본 페이로드 보존 (감사용)
  result          PaymentEventResult
  errorMessage    String?
  createdAt       DateTime           @default(now())

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([paymentId, createdAt])
  @@index([type, createdAt])
}

// Phase 4-B: 출발 취소 fan-out 배치 진행 상태 (RefundJob 상태에서 파생). [ADR-0028]
enum DepartureCancellationStatus {
  PROCESSING // 환불 job 일부 미종결
  COMPLETED // 전 건 종결 + 실패 0
  PARTIALLY_FAILED // 전 건 종결 but FAILED 1건 이상 (admin 재시도 필요)
}

// 출발 취소 1회 = 배치 1개. 결제 여부 무관 N건 예약 취소를 통합 추적. [ADR-0028]
model DepartureCancellation {
  id               String                      @id @default(cuid())
  departureId      String
  status           DepartureCancellationStatus @default(PROCESSING)
  totalBookings    Int // 취소 시점 활성(좌석점유) 예약 수
  immediateCancels Int                         @default(0) // 미결제 → 즉시 취소된 건수
  actor            String // "admin:<id>"
  reason           String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  departure  Departure   @relation(fields: [departureId], references: [id], onDelete: Cascade)
  refundJobs RefundJob[]

  @@index([status])
  @@index([departureId])
}

enum RefundJobStatus {
  PENDING
  IN_PROGRESS
  SUCCEEDED
  FAILED
}

model RefundJob {
  id             String          @id @default(cuid())
  bookingId      String
  paymentId      String
  amount         Int // 실제 환불액 = baseAmount − penaltyAmount (위약금 0이면 결제 전액)
  penaltyAmount  Int             @default(0) // 취소 요청 시점 동결된 위약금 스냅샷 (spec §4)
  reason         String?
  // 환불을 트리거한 주체. worker가 재시도 시 booking transition(user vs agency)을
  // 정확히 분기하기 위해 필요. ex) "user:cluser...", "admin:...", "system:webhook"
  // nullable: 기존 row 호환. 신규 enqueue부터 채움.
  actor          String?
  // Phase 8: 여러 부분 환불 Ledger 필드
  kind           RefundKind      @default(FULL_CANCEL)
  baseAmount     Int             @default(0)
  seatsReleased  Int             @default(0)
  idempotencyKey String?         @unique
  status         RefundJobStatus @default(PENDING)
  attempts       Int             @default(0)
  lastError      String?
  nextRunAt      DateTime        @default(now()) // exponential backoff
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Phase 4-B: 출발 취소 fan-out 배치 연결 (단일 사용자 환불은 null). [ADR-0028]
  cancellationBatchId String?

  booking           Booking                @relation(fields: [bookingId], references: [id])
  payment           Payment                @relation(fields: [paymentId], references: [id])
  cancellationBatch DepartureCancellation? @relation(fields: [cancellationBatchId], references: [id], onDelete: SetNull)

  @@index([status, nextRunAt])
  @@index([cancellationBatchId])
}

enum EmbeddingJobStatus {
  PENDING
  IN_PROGRESS
  SUCCEEDED
  FAILED
}

// 상품 벡터 임베딩 비동기 워커 큐.
// RefundJob 패턴과 동일한 status / attempts / nextRunAt / lastError / actor / version 구조.
// 단 onDelete는 Cascade — RefundJob과 다름(RefundJob은 RESTRICT 디폴트). Product 하드 삭제 시
// 잔존 job은 의미가 없으므로 같이 정리한다.
// cron worker가 PENDING 행을 픽업하여 임베딩 생성 후 ProductEmbedding을 upsert.
model EmbeddingJob {
  id          String             @id @default(cuid())
  productId   String
  status      EmbeddingJobStatus @default(PENDING)
  attempts    Int                @default(0)
  lastError   String?            @db.Text
  nextRunAt   DateTime           @default(now()) // exponential backoff
  // enqueue 시 선택적. ex) "admin:cuid", "system:modelbump"
  actor       String?
  // worker가 완료 시점에 기록하는 콘텐츠 해시 (디버깅 추적용).
  // 실제 재인덱싱 판단은 ProductEmbedding.contentHash와 비교.
  contentHash String?
  version     Int                @default(0) // 낙관적 락 보조 (RefundJob 패턴 동일)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status, nextRunAt]) // cron picker: WHERE status='PENDING' AND nextRunAt <= now()
  @@index([productId, status]) // idempotent enqueue: 중복 PENDING 행 검사
}

enum EmailType {
  BOOKING_CONFIRMATION // 예약 확정서 + 결제 영수증 (PAID 전이)
  REFUND_COMPLETED // 환불 처리 완료 안내 (PAID/READY → CANCELED)
  PARTIAL_REFUND_COMPLETED // 부분 환불 완료 안내 (TRAVELER_CANCEL/DISCRETIONARY)
}

enum EmailJobStatus {
  PENDING
  IN_PROGRESS
  SUCCEEDED
  FAILED
}

// 거래 종료 알림 메일 비동기 큐. EmbeddingJob/RefundJob과 동형
// (status/attempts/lastError/nextRunAt/@@index). 트랜잭셔널 아웃박스:
// booking 상태전이 Tx 안에서 적재되어 유실 0. payload 컬럼 없음 —
// bookingId만으로 워커가 발송 시점에 전체 데이터를 hydrate한다.
model EmailJob {
  id         String         @id @default(cuid())
  type       EmailType
  // 멱등 enqueue 키. ex) "booking-confirmation:<bookingId>" / "refund-completed:<bookingId>"
  dedupeKey  String         @unique
  bookingId  String
  // PARTIAL_REFUND_COMPLETED 타입일 때만 설정. 이 메일이 보고하는 RefundJob의 id.
  // (예약 한 건에 부분 환불이 여러 번 발생할 수 있으므로 bookingId만으로 식별 불가)
  // 워커가 hydration 시점에 RefundJob을 id로 직접 조회 — back-relation 없이 스칼라만 저장.
  refundJobId String?
  status     EmailJobStatus @default(PENDING)
  attempts   Int            @default(0)
  lastError  String?        @db.Text
  nextRunAt  DateTime       @default(now()) // 지수 백오프
  sentTo     String? // 발송 시점 수신 주소 스냅샷 (감사)
  providerId String? // Resend 메시지 id (감사 + 멱등 추적)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status, nextRunAt]) // cron picker
}

// ─────────────────────────────────────────────────────────────
// 6. 리뷰 & 사진 후기 (PRD §4.2)
// ─────────────────────────────────────────────────────────────
// COMPLETED booking 보유자만 작성. 1 booking = 1 review (unique).
// 사진은 정규화 1:N — 사진 단위 모더레이션·재정렬·메타 확장을 위해.
// Storage path: review-photos/<reviewId>/<idx>.<ext> (product-images 버킷 재사용).

enum ReviewStatus {
  PUBLISHED // 정상 노출
  HIDDEN // 어드민 숨김 (모더레이션)
  REPORTED // 사용자 신고 (모더레이션 대기)
}

model Review {
  id        String       @id @default(cuid())
  bookingId String       @unique // 1 booking = 1 review (자격 + 중복 방지)
  userId    String
  productId String
  rating    Int // 1~5 (Zod min/max)
  content   String       @db.Text // max 1000자
  status    ReviewStatus @default(PUBLISHED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  booking Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  photos  ReviewPhoto[]

  @@index([productId, status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model ReviewPhoto {
  id          String @id @default(cuid())
  reviewId    String
  storagePath String // "review-photos/<reviewId>/<idx>.<ext>"
  order       Int
  width       Int?
  height      Int?

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, order])
  @@index([reviewId])
}
